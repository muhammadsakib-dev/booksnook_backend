# ==============================================================================
# BookNook Backend Environment Variables Template
# ==============================================================================
# In Production (Render/Railway), add these variables in your platform dashboard.
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# Server Port (Defaults to 8000)
PORT=8000
NODE_ENV=development

# Backend and Frontend Public URLs (Unified with frontend names)
# In development:
API_URL=http://localhost:8000
APP_URL=http://localhost:3000
# In production:
# API_URL=https://<your-backend-app>.vercel.app
# APP_URL=https://<your-frontend-app>.vercel.app

# MongoDB Connection String (Supports both MONGODB_URI and MONGODB_URL)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=assignment-08

# Secret Key (Must match BETTER_AUTH_SECRET from frontend)
BETTER_AUTH_SECRET=your_super_secret_32_character_encryption_key_here

# (Optional overrides - automatically derived from APP_URL & API_URL if omitted)
# ALLOWED_ORIGIN=http://localhost:3000
# TOKEN_ISSUER=http://localhost:3000
# TOKEN_AUDIENCE=http://localhost:8000
# JWKS_URL=http://localhost:3000/api/auth/jwks

