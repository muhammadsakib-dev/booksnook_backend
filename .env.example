# ==============================================================================
# BookNook Backend (Express.js + MongoDB Native Driver) Environment Variables
# ==============================================================================
# NOTE: Copy this file to .env for local development.
# NEVER commit .env containing real production credentials to version control.
# ==============================================================================

# Server Listening Port (Render assigns this automatically via process.env.PORT)
PORT=8000

# Environment Mode (development | production | test)
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas Replica Set recommended for transactions)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Target Database Name
DB_NAME=assignment-08

# Allowed CORS Origins (supports comma-separated list of local and production origins)
# Example: http://localhost:3000,https://booknook-client.vercel.app
ALLOWED_ORIGIN=http://localhost:3000

# ==============================================================================
# JWT Authentication & Cryptographic Verification
# ==============================================================================

# Shared BetterAuth Cryptographic Secret
# MUST MATCH the BETTER_AUTH_SECRET configured in booknook_client!
BETTER_AUTH_SECRET=your_super_secret_32_character_encryption_key_here

# JWT Issuer verification claim (Should match the frontend BetterAuth base URL)
# Local: http://localhost:3000
# Production: https://booknook-client.vercel.app
TOKEN_ISSUER=http://localhost:3000

# JWT Audience verification claim (Should match the backend API base URL)
# Local: http://localhost:8000
# Production: https://booknook-api.onrender.com
TOKEN_AUDIENCE=http://localhost:8000

# Remote JWKS URL for asymmetric key verification fallback
JWKS_URL=http://localhost:3000/api/auth/jwks
