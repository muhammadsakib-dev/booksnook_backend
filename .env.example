# ==============================================================================
# BookNook Backend Environment Variables Template
# ==============================================================================
# In Production (Render/Railway), add these variables in your platform dashboard.
# NEVER commit your real .env file with secrets to Git.
# ==============================================================================

# Server Port (Render/Railway sets PORT automatically; keep default or 8000)
PORT=8000
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=assignment-08

# CORS Allowed Origin (Set to your live frontend Vercel URL)
# Example: https://booknook-client.vercel.app
ALLOWED_ORIGIN=https://<your-frontend-app>.vercel.app

# JWT Verification Configuration (Synchronized with Better-Auth on Frontend)
# TOKEN_ISSUER must match BETTER_AUTH_URL from frontend
TOKEN_ISSUER=https://<your-frontend-app>.vercel.app

# TOKEN_AUDIENCE must match NEXT_PUBLIC_API_URL from frontend (your backend URL)
TOKEN_AUDIENCE=https://<your-backend-app>.onrender.com

# JWKS endpoint on the frontend for public key verification
JWKS_URL=https://<your-frontend-app>.vercel.app/api/auth/jwks

# Secret Key (Must match BETTER_AUTH_SECRET from frontend)
BETTER_AUTH_SECRET=your_super_secret_32_character_encryption_key_here

